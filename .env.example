NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, bypasses RLS — never prefix NEXT_PUBLIC_, never import from a
# Client Component. Used by src/libs/supabase/admin.ts for the admin
# "Tambah User" feature (creates auth users directly). Needed at runtime —
# must be set in Vercel too, not just locally.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron signs requests to /api/cron/* with `Authorization: Bearer
# $CRON_SECRET` automatically when this is set — the route checks it. Set
# any random secret string in Vercel; safe to leave unset locally (the
# route skips the check when it's absent).
CRON_SECRET=

# Server-only, full DB access — never prefix NEXT_PUBLIC_. Used for one-off
# migration scripts only, never imported by app code.
SUPABASE_DB_URL=
